# Configuración del Panel de Administración
# Variables de entorno para el panel admin

# URL de la API del panel admin
VITE_ADMIN_API_URL=http://localhost:3001/api/admin

# URL del dashboard de doctores (para referencia)
VITE_DOCTOR_DASHBOARD_URL=http://localhost:5173

# Configuración de autenticación
VITE_JWT_SECRET=your-jwt-secret-key-here
VITE_TOKEN_EXPIRY=24h

# Configuración de la base de datos
VITE_DB_HOST=localhost
VITE_DB_PORT=5432
VITE_DB_NAME=neuralapp_admin
VITE_DB_USER=admin_user
VITE_DB_PASSWORD=admin_password

# Configuración de seguridad
VITE_ENABLE_AUDIT_LOGS=true
VITE_LOG_RETENTION_DAYS=90
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_LOCKOUT_DURATION_MINUTES=30

# Configuración de notificaciones
VITE_ENABLE_EMAIL_NOTIFICATIONS=true
VITE_SMTP_HOST=smtp.gmail.com
VITE_SMTP_PORT=587
VITE_SMTP_USER=admin@neuralapp.cloud
VITE_SMTP_PASSWORD=your-smtp-password

# Configuración de archivos
VITE_MAX_FILE_SIZE_MB=10
VITE_ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Configuración de paginación
VITE_DEFAULT_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100

# Configuración de cache
VITE_CACHE_TTL_SECONDS=300
VITE_ENABLE_CACHE=true

# Configuración de monitoreo
VITE_ENABLE_ANALYTICS=true
VITE_ANALYTICS_ID=your-analytics-id

# Configuración de desarrollo
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info
