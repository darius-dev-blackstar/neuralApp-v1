# Variables de entorno para el Panel Administrativo
# Separadas completamente del dashboard médico

# API Configuration
VITE_API_URL=https://api.neuralapp.cloud/admin
VITE_ENV=production

# Frontend URLs
VITE_ADMIN_FRONTEND_URL=https://admin.neuralapp.cloud
VITE_DOCTOR_DASHBOARD_URL=https://app.neuralapp.cloud

# Authentication
VITE_JWT_SECRET=super-secret-admin-key
VITE_TOKEN_EXPIRY=24h

# CORS Configuration
VITE_CORS_ORIGIN=https://admin.neuralapp.cloud

# Storage Keys (separados del dashboard médico)
VITE_ADMIN_TOKEN_KEY=neuralapp_admin_token
VITE_ADMIN_USER_KEY=neuralapp_admin_user

# App Configuration
VITE_APP_NAME=NeuralApp Admin
VITE_APP_DOMAIN=admin.neuralapp.cloud
VITE_NODE_ENV=production