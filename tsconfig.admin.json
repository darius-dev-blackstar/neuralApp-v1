{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-admin",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/admin/**/*",
    "src/index.css",
    "src/vite-env.d.ts"
  ],
  "exclude": [
    "src/doctor/**/*",
    "src/pages/**/*",
    "src/modules/**/*",
    "src/services/auth.ts",
    "src/components/layout/**/*",
    "src/components/ProtectedRoute.tsx",
    "node_modules",
    "dist",
    "dist-admin",
    "dist-doctor"
  ]
}